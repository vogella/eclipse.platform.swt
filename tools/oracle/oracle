#!/usr/bin/env bash
# The oracle command line entry point.
#
# Usage: tools/oracle/oracle <verb> [args]
#
# Compiles the harness (fast, always recompiles) and runs it against the
# native backend classpath. Verbs that need a Display are run headless where
# the platform needs it (Xvfb with the Wayland variables unset and GDK pinned
# to X11 on Linux), so a caller never has to remember the incantation; see
# platform.sh and docs/visual-oracle/PLAN.md.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=platform.sh
. "$SCRIPT_DIR/platform.sh"

die() { printf 'oracle: %s\n' "$*" >&2; exit 2; }

[ $# -ge 1 ] || die "usage: oracle <verb> [args], try 'oracle help'"

verb="$1"

classes="$("$SCRIPT_DIR/build-harness.sh")" || die "building harness failed"

REPO_ROOT="$(oracle_native_path "$(cd "$SCRIPT_DIR/../.." && pwd)")"
native_cp="$("$SCRIPT_DIR/build.sh" native)" || die "building native backend classpath failed"

main_class=org.eclipse.swt.visualoracle.tools.OracleCli
java_cmd=(
	java --enable-native-access=ALL-UNNAMED
	${ORACLE_PLATFORM_JAVA_OPTS[@]+"${ORACLE_PLATFORM_JAVA_OPTS[@]}"}
	-Djava.library.path="$(oracle_binaries_dir "$REPO_ROOT")"
	-Doracle.repoRoot="$REPO_ROOT"
	-cp "$classes$ORACLE_CP_SEP$native_cp"
	"$main_class"
)

case "$verb" in
	help|-h|--help|version|--version)
		exec "${java_cmd[@]}" "$@"
		;;
	selftest)
		oracle_run_headless "${ORACLE_TIMEOUT[@]}" 900 "${java_cmd[@]}" "$@"
		;;
	run|triage)
		oracle_run_headless "${java_cmd[@]}" "$@"
		;;
	*)
		"${java_cmd[@]}" "$@" || true
		exit 2
		;;
esac
